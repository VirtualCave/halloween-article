    b: "" {class: calabaza; width: 466; height: 44}
    v: "11,7k × 10 = 117k" {class: pie; label.near: center-left; width: 170; height: 44}
  }
  r3: {
    class: invisible
    label: ""
    grid-columns: 3
    grid-gap: 10
    n: "Página de docs: caché" {class: pie; label.near: center-right; width: 300; height: 44}
    b: "" {class: calabaza; width: 396; height: 44}
    v: "11,0k × 9 = 99k" {class: pie; label.near: center-left; width: 170; height: 44}
