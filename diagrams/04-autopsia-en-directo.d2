...@estilo

titulo: "Autopsia en directo: la sesión que preparó este artículo" {class: titulo}

datos: {
  class: invisible
  label: ""
  grid-rows: 9
  grid-gap: 10

  resumen: {
    class: invisible
    label: ""
    grid-columns: 3
    grid-gap: 14
    a: {
      class: tarjeta
      label: ""
      grid-rows: 2
      grid-gap: 0
      n: "26" {class: numero; width: 330; height: 60}
      t: "llamadas del hilo principal" {class: pie; width: 330; height: 36}
    }
    b: {
      class: tarjeta
      label: ""
      grid-rows: 2
      grid-gap: 0
      n: "163.100" {class: numero; width: 330; height: 60}
      t: "tokens de contexto por llamada" {class: pie; width: 330; height: 36}
    }
    c: {
      class: tarjeta
      label: ""
      grid-rows: 2
      grid-gap: 0
      n: "4,04 M" {class: numero; width: 330; height: 60}
      t: "tokens leídos de caché" {class: pie; width: 330; height: 36}
    }
  }

  cabecera: "Lo que más arrastró: tamaño del resultado × llamadas posteriores" {class: etiqueta; width: 1018; height: 50}

  r1: {
    class: invisible
    label: ""
    grid-columns: 3
    grid-gap: 10
    n: "Leer el código de audit.py" {class: pie; label.near: center-right; width: 300; height: 44}
    b: "" {class: sangre; width: 529; height: 44}
    v: "6,3k × 21 = 132k" {class: pie; label.near: center-left; width: 170; height: 44}
  }
  r2: {
    class: invisible
    label: ""
