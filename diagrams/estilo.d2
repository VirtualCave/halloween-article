# Paleta compartida: noche Virtual Cave (navy + magenta) con calabaza y ectoplasma de Halloween.
# Cada diagrama la importa con `...@estilo`.
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
    pad: 48
    theme-overrides: {
      N1: "#F4F1FF"
      N2: "#AEB8DA"
      N3: "#7D89B3"
      N4: "#3A4F8C"
      N5: "#22356B"
      N6: "#12214A"
      N7: "#0A1633"
      B1: "#FF8A1F"
      B2: "#FF8A1F"
      B3: "#2F4583"
      B4: "#1A2D60"
      B5: "#12214A"
      B6: "#0E1B3D"
      AA2: "#FF5C9D"
      AA4: "#C2185B"
      AA5: "#9C1350"
      AB4: "#5CF2A6"
      AB5: "#2E8F63"
    }
  }
}

style: {
  fill: "#0A1633"
  stroke: "#0A1633"
}

classes: {
  titulo: {
    shape: text
    near: top-center
    style: {
      font-size: 32
      bold: true
      font-color: "#F4F1FF"
    }
  }
  nota: {
    shape: text
    style: {
      font-size: 18
      font-color: "#AEB8DA"
    }
  }
  caja: {
    style: {
      fill: "#12214A"
      stroke: "#2F4583"
      stroke-width: 2
      border-radius: 10
      font-color: "#F4F1FF"
      font-size: 18
    }
  }
  niebla: {
    style: {
      fill: "#16264F"
      stroke: "#2F4583"
      stroke-width: 2
      border-radius: 6
      font-color: "#AEB8DA"
      font-size: 16
    }
  }
  calabaza: {
    style: {
      fill: "#3A230D"
      stroke: "#FF8A1F"
      stroke-width: 2
      border-radius: 6
      font-color: "#FFE3C7"
      font-size: 16
      bold: true
    }
  }
  sangre: {
    style: {
      fill: "#3B0F24"
      stroke: "#FF4D5E"
      stroke-width: 2
      border-radius: 10
      font-color: "#FFD6DC"
      font-size: 18
    }
  }
  magenta: {
    style: {
      fill: "#C2185B"
      stroke: "#FF5C9D"
      stroke-width: 2
      border-radius: 10
      font-color: "#FFFFFF"
      font-size: 18
      bold: true
    }
  }
  ecto: {
    style: {
      fill: "#0D3A2E"
      stroke: "#5CF2A6"
      stroke-width: 2
      border-radius: 10
      font-color: "#D9FFEC"
      font-size: 18
    }
  }
  grupo: {
    style: {
      fill: "#0E1B3D"
      stroke: "#2F4583"
      stroke-width: 2
      stroke-dash: 4
      border-radius: 14
      font-color: "#AEB8DA"
      font-size: 20
      bold: true
    }
  }
  tumba: {
    style: {
      fill: "#0E1B3D"
      stroke: "#3A4F8C"
      stroke-width: 2
      stroke-dash: 4
      border-radius: 6
      font-color: "#7D89B3"
      font-size: 16
    }
  }
  etiqueta: {
    style: {
      fill: transparent
      stroke: transparent
      font-color: "#F4F1FF"
      font-size: 18
      bold: true
    }
  }
  numero: {
    style: {
      fill: transparent
      stroke: transparent
      font-color: "#FF5C9D"
      font-size: 44
      bold: true
    }
  }
  pie: {
    style: {
      fill: transparent
      stroke: transparent
      font-color: "#D7DCF0"
      font-size: 18
      bold: false
    }
  }
  linea: {
    style: {
      fill: transparent
      stroke: transparent
      font: mono
      font-size: 20
      font-color: "#AEB8DA"
      bold: false
    }
  }
  tarjeta: {
    style: {
      fill: "#12214A"
      stroke: "#2F4583"
      stroke-width: 2
      border-radius: 14
    }
  }
  invisible: {
    style: {
      fill: transparent
      stroke: transparent
      font-color: "#AEB8DA"
    }
  }
  flecha: {
    style: {
      stroke: "#AEB8DA"
      stroke-width: 2
      font-color: "#F4F1FF"
      font-size: 16
    }
  }
}
