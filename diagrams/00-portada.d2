...@estilo

portada: {
  class: invisible
  label: ""
  grid-rows: 4
  grid-gap: 16

  kicker: "HISTORIAS DE TERROR REALES EN 2026" {class: etiqueta; style.font-color: "#FF8A1F"; style.font-size: 22; width: 1000; height: 32}
  titular: "Daily limit reached" {class: etiqueta; style.font-size: 64; width: 1000; height: 84}

  terminal: "claude  ·  ~/proyectos/pagos" {
    class: tarjeta
    style.fill: "#060C1E"
    style.stroke: "#FF8A1F"
    style.font-color: "#7D89B3"
    style.font-size: 16
    label.near: top-left
    grid-rows: 8
    grid-gap: 4

    l0: " " {class: linea; width: 940; height: 14}
    l1: "> refactoriza el módulo de pagos y deja los tests en verde" {class: linea; style.font-color: "#F4F1FF"; label.near: center-left; width: 940; height: 34}
    l2: "● Read 47 ficheros" {class: linea; label.near: center-left; width: 940; height: 34}
    l3: "● Bash mvn test · 3.214 líneas de salida" {class: linea; label.near: center-left; width: 940; height: 34}
    l4: "● Edit PaymentService.java" {class: linea; label.near: center-left; width: 940; height: 34}
    l5: "● Bash mvn test · otras 3.214 líneas" {class: linea; label.near: center-left; width: 940; height: 34}
    l6: " " {class: linea; width: 940; height: 12}
    l7: "You've hit your session limit · resets 3:45pm" {class: linea; style.font-color: "#FF4D5E"; style.bold: true; label.near: center-left; width: 940; height: 34}
  }

  pie: "Martes, 11:47. Cuatro horas de silencio por delante." {class: nota; width: 1000; height: 32}
}
